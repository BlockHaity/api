{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/random-image.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/baapk.json",
      "destination": "/baapk.json"
    },
    {
      "source": "/baapk/global",
      "destination": "https://d.apkpure.net/b/XAPK/com.nexon.bluearchive?version=latest"
    },
    {
      "source": "/baapk/jp",
      "destination": "https://d.apkpure.net/b/XAPK/com.YostarJP.BlueArchive?version=latest"
    },
    {
      "source": "/images",
      "destination": "/api/random-image"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/random-image/:path*"
    },
    {
      "source": "/gh-download",
      "destination": "/api/gh-download"
    },
    {
      "source": "/getbaah",
      "destination": "/api/getbaah"
    },
    {
      "source": "/agnes-api",
      "destination": "/api/agnes-api"
    },
    {
      "source": "/agnes-api/:path*",
      "destination": "/api/agnes-api?__path=:path*"
    },
    {
      "source": "/agnes-media",
      "destination": "/api/agnes-media"
    },
    {
      "source": "/agnes-media/:path*",
      "destination": "/api/agnes-media?__path=:path*"
    },
    {
      "source": "/fish-audio-api/openai",
      "destination": "/api/fish-audio-openai"
    },
    {
      "source": "/fish-audio-api/openai/:path*",
      "destination": "/api/fish-audio-openai?__path=:path*"
    },
    {
      "source": "/fish-audio-api",
      "destination": "/api/fish-audio"
    },
    {
      "source": "/fish-audio-api/:path*",
      "destination": "/api/fish-audio?__path=:path*"
    }
  ]
}